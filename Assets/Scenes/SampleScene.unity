  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uCCB4\uB825:0\uC774\uB418\uBA74 \uD328\uBC30\n\uBCF4\uD638\uB9C9:\uCCB4\uB825\uB300\uC2E0
    \uB9DE\uC544\uC90C \uD134\uC2DC\uC791\uC2DC \uC808\uBC18\uC774\uB428\n\uC78E:\uC704\uB85C
    \uB04C\uC5B4 \uC0AC\uC6A9(\uACF5\uACA9\uC740 \uC801\uC5D0\uAC8C \uB04C\uC5B4\uC11C)
    \uAC19\uC740 \uC22B\uC790 \uB610\uB294 \uAC19\uC740 \uC0C9\uC0C1 + \uC774\uC5B4\uC9C0\uB294
    \uC22B\uC790 \n(\uD770\uC0C9 \uAC80\uC815\uC0C9\uC740 \uAC19\uC740\uC0C9 \uCDE8\uAE09,
    \uD134\uB9C8\uB2E4 \uCC98\uC74C\uB0B4\uB294 \uC78E\uC740 \uAC19\uC740 \uC0C9\uC0C1\uB9CC\uC73C\uB85C\uB3C4
    \uAC00\uB2A5, \u03C3\uB294 0\uC778 \uB3D9\uC2DC\uC5D0 6)\n\uCC28\uB840 \uC2DC\uC791\uC2DC
    \uD328\uC758 \uC78E\uC774 5\uC7A5\uC774 \uB418\uB3C4\uB85D \uBF51\uB294\uB2E4
    \uC0AC\uC6A9\uD55C \uC78E \uB354\uBBF8\uC5D0 \uC78E\uC744  \uB04C\uBA74 \uBC84\uB9AC\uAE30\n\uBE68\uAC15->\uCD08\uB85D->\uD30C\uB791->\uBE68\uAC15,
    \uD770\uC0C9<->\uAC80\uC815\uC0C9 \uBC88\uAC08\uC544 \uB0B4\uBA74 \uC78E \uD6A8\uACFC
    2\uBC88 \uBC1C\uB3D9"
